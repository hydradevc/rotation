[Unit]
Description=HYDRA API key rotator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra
WorkingDirectory=/opt/hydra
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HYDRA_DATA=/var/lib/hydra
# Set the admin password before the first start, or drop this line and read it from the console once.
# Environment=HYDRA_ADMIN_PASSWORD=change-me
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/hydra

[Install]
WantedBy=multi-user.target
